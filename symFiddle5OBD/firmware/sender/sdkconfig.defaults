# ESP32-S3 N16R8
CONFIG_IDF_TARGET="esp32s3"

# 16MB Flash / 8MB Octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 只发 ESP-NOW，不开蓝牙（省 RAM 和功耗）
CONFIG_BT_ENABLED=n

# 关掉 Wi-Fi 省电，否则射频休眠会让 ESP-NOW 延迟抖动变大
CONFIG_ESP_WIFI_SLP_IRAM_OPT=y

# 日志级别：正式装车时改回 INFO；调协议时用 DEBUG
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 自定义分区表：默认单 app 只给 1MB，不够用（理由见 partitions.csv 顶部注释）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 日志只走 UART0：发送端只接 CH340，原生 USB 口悬空，
# 开着 USB-Serial-JTAG 次级控制台会导致应用启动后卡住（无主机时写阻塞）
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 与接收端对齐：调试优化(-Og)下启动会卡在 cpu_start，改 PERF
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# 发送端不需要 8MB PSRAM（CAN 轮询几百 KB 就够）。
# 打开时 PERF 优化下会崩在 esp_psram_impl_enable，关掉排除这个变量。
# CONFIG_SPIRAM is not set
